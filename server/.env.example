# ── Menler outreach backend ──
PORT=4200

# Same Atlas cluster as the marketing site / LMS. This service only touches
# out_* collections, so it never collides with leads, orders or lms_* data.
MONGODB_URI=

# Long random string — signs the admin session cookie and tracking tokens.
JWT_SECRET=

# Admin panel login (single shared team login).
OUTREACH_USERNAME=
OUTREACH_PASSWORD=

# Base URL of the outreach admin UI (CORS allow-list; comma-separate for many).
OUTREACH_APP_URL=http://localhost:5175

# Public URL of THIS API — used to build unsubscribe / open / click links.
# Must be reachable from recipients' mail clients.
API_PUBLIC_URL=http://localhost:4200

# ── Sending ──────────────────────────────────────────────────────────────────
# PREFERRED: Resend over HTTPS. Set this and the SMTP block below is ignored.
# Managed hosts (Render, Railway, Fly free tiers) firewall outbound 25/465/587,
# so SMTP there fails with "connection timeout" regardless of credentials.
# Port 443 is never blocked, so the API works everywhere.
OUTREACH_RESEND_API_KEY=

# Fallback: any SMTP provider. Used only when the key above is empty.
# IMPORTANT: use a DEDICATED cold-outreach provider + domain here
# (e.g. outreach.menler.in via Instantly / Smartlead / Amazon SES).
# Never reuse the transactional provider that sends certificates and receipts —
# a spam complaint there would take those down with it.
OUTREACH_SMTP_HOST=
OUTREACH_SMTP_PORT=587
OUTREACH_SMTP_USER=
OUTREACH_SMTP_PASS=
OUTREACH_FROM_NAME=Menler
OUTREACH_FROM_EMAIL=
# Where replies land — must be a mailbox a human actually watches.
OUTREACH_REPLY_TO=

# Appended to every email. Legally you need a real postal address here.
OUTREACH_SIGNATURE=Rochan Reddy
Menler — AI education
menler.in | <your postal address>

# Secret for the external cron trigger:
#   GET /api/campaigns/ops/cron/<token>
# Needed on a free host, where the service sleeps when idle and the in-process
# scheduler stops with it. Point cron-job.org (or similar) at that URL every
# 15-30 min during your sending window. Leave blank to disable the endpoint.
OUTREACH_CRON_TOKEN=

# Set to "off" to run the API without the background sender (e.g. a second instance).
OUTREACH_SCHEDULER=on
